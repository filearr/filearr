# Copy to .env and adjust
POSTGRES_PASSWORD=change-me-too
MEILI_MASTER_KEY=change-me

FILEARR_DATABASE_URL=postgresql+psycopg://filearr:change-me-too@postgres:5432/filearr
FILEARR_PROCRASTINATE_DSN=postgresql://filearr:change-me-too@postgres:5432/filearr
FILEARR_MEILI_URL=http://meilisearch:7700
FILEARR_MEILI_MASTER_KEY=change-me
FILEARR_AUTH_ENABLED=true
FILEARR_RECYCLE_RETENTION_DAYS=30

# Optional features — explicit with their defaults (see the docs:
# reference/configuration.md "Optional features"). Flip any of these to change
# behaviour; the compose file declares the same defaults, so leaving a line out
# keeps the value shown here.
# semantic/hybrid search (worker loads a local ONNX model when on)
FILEARR_SEMANTIC_ENABLED=false
# libmagic reclassification of extensionless files (on-demand maintenance action)
FILEARR_CONTENT_SNIFF_ENABLED=false
# auto-refresh the GitHub update-check cache (only automatic outbound call)
FILEARR_UPDATE_CHECK_AUTO=false
# advisory thumbnail cache budget in GiB (0 = off; nothing is ever deleted)
FILEARR_THUMBNAIL_BUDGET_GB=5
# record the log stream for the console Logs panel
FILEARR_LOG_DB_ENABLED=true
# distributed agent fleet surface
FILEARR_AGENTS_ENABLED=false

# Unraid conventions
PUID=99
PGID=100
TZ=Etc/UTC

# Host path to media library (mounted read-only at /data/media)
MEDIA_PATH=/mnt/user/data/media
